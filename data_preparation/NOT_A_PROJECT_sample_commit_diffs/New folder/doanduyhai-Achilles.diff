+                "AND gc_grace_seconds = 9999 " +
+                "AND index_interval = 512 " +
+                "AND memtable_flush_period_in_ms = 12 " +
+                "AND populate_io_cache_on_flush = true " +
+                "AND replicate_on_write = true " +
+                "AND speculative_retry = 'ALWAYS'");
